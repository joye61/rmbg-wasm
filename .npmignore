# Files excluded from the published package.
#
# The authoritative allowlist is the "files" field in package.json; this file is
# an extra guard for anything that should never ship.

# Development / repository only
test/
scripts/
.github/
.git/
.gitattributes
.gitignore
.npmignore

# Build & install artifacts
node_modules/
*.tgz
*.tar.gz
package-lock.json
npm-debug.log*
yarn-error.log*
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
